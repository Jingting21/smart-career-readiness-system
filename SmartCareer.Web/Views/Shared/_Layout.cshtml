@using Microsoft.AspNetCore.Identity
@using SmartCareer.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{ var isSignedIn = SignInManager.IsSignedIn(User); var pageTitle = ViewData["Title"]?.ToString() ?? "SmartCareer"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="theme-color" content="#ffffff" />
    <title>@pageTitle | SmartCareer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartCareer.Web.styles.css" asp-append-version="true" />
</head>
<body class="@(isSignedIn ? "app-body" : "public-body")">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    @if (isSignedIn)
    {
        <header class="app-header">
            <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
            <a class="brand" asp-controller="Home" asp-action="Dashboard" aria-label="SmartCareer dashboard"><span class="brand-mark">S</span><span>SmartCareer</span></a>
            <div class="app-page-context"><span>Your workspace</span><strong>@pageTitle</strong></div>
            <partial name="_LoginPartial" />
        </header>
        <div class="app-shell"><partial name="_StudentSidebar" /><main id="main-content" class="app-main" role="main">@RenderBody()</main></div>
    }
    else
    {
        <header class="public-header"><nav class="navbar navbar-expand-lg" aria-label="Main navigation"><div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>SmartCareer</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="publicNav"><ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a></li><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a></li><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a></li>
            </ul><partial name="_LoginPartial" /></div>
        </div></nav></header>
        <main id="main-content" role="main">@RenderBody()</main>
    }
    <partial name="_Footer" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body></html>
