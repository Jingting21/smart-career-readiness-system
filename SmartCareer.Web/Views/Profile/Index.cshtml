@model SmartCareer.Web.ViewModels.StudentProfileViewModel
@using SmartCareer.Web.Models
@{ ViewData["Title"] = "My Profile"; }
<div class="profile-page" data-profile-page data-editing="@Model.IsEditing.ToString().ToLowerInvariant()"><header class="profile-heading"><div><span class="eyebrow">Your student profile</span><h1>My Profile</h1><p>Keep your personal and education details accurate so SmartCareer can support your journey.</p></div><button type="button" class="btn btn-primary" data-profile-edit>Edit profile</button></header>
@if (TempData["ProfileSuccess"] is string message) { <div class="profile-alert success" role="status"><span>✓</span><div><strong>Changes saved</strong><p>@message</p></div></div> }
<form id="profile-form" asp-controller="Profile" asp-action="Index" method="post" class="profile-form" novalidate data-validation-focus data-server-validation-errors="@(!ViewData.ModelState.IsValid).ToString().ToLowerInvariant()"><div asp-validation-summary="All" class="validation-summary" role="alert" data-profile-validation-summary></div>
@Html.AntiForgeryToken()
<section class="profile-section-card"><div class="profile-section-heading"><span class="feature-icon">○</span><div><h2>Personal information</h2><p>The essential details connected to your account.</p></div></div><div class="profile-form-grid"><div class="field-group"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" data-profile-field disabled /><span asp-validation-for="FullName" class="text-danger"></span></div><div class="field-group"><label asp-for="Email">Email address</label><input asp-for="Email" class="form-control readonly-field" readonly /><small class="field-help">Email changes are not available here.</small></div></div></section>
<section class="profile-section-card"><div class="profile-section-heading"><span class="feature-icon">◇</span><div><h2>Education information</h2><p>Choose recognised details or use Other for a manual entry.</p></div></div><div class="profile-form-grid">
<div class="field-group selection-field" data-controlled-selection><label asp-for="University"></label><input asp-for="UniversitySelectionMode" type="hidden" data-selection-mode data-profile-field disabled /><input asp-for="UniversityConfirmed" type="hidden" data-selection-confirmed data-profile-field disabled /><div data-catalog-field><input asp-for="University" class="form-control" data-profile-field disabled data-autocomplete-url="/api/registration-options/universities" aria-controls="profile-university-suggestions" aria-expanded="false" role="combobox" /><div id="profile-university-suggestions" class="autocomplete-list"></div><span asp-validation-for="University" class="text-danger"></span></div><div data-custom-field><input asp-for="CustomUniversity" class="form-control" data-profile-field disabled data-rule-manualentry="university" /><small class="field-help">Manually entered and unverified university</small><span asp-validation-for="CustomUniversity" class="text-danger"></span></div><button type="button" class="selection-switch" data-selection-switch data-profile-control disabled></button></div>
<div class="field-group selection-field" data-controlled-selection><label asp-for="Course"></label><input asp-for="CourseSelectionMode" type="hidden" data-selection-mode data-profile-field disabled /><input asp-for="CourseConfirmed" type="hidden" data-selection-confirmed data-profile-field disabled /><div data-catalog-field><input asp-for="Course" class="form-control" data-profile-field disabled data-autocomplete-url="/api/registration-options/courses" aria-controls="profile-course-suggestions" aria-expanded="false" role="combobox" /><div id="profile-course-suggestions" class="autocomplete-list"></div><span asp-validation-for="Course" class="text-danger"></span></div><div data-custom-field><input asp-for="CustomCourse" class="form-control" data-profile-field disabled data-rule-manualentry="course" /><small class="field-help">Manually entered and unverified course</small><span asp-validation-for="CustomCourse" class="text-danger"></span></div><button type="button" class="selection-switch" data-selection-switch data-profile-control disabled></button></div>
<div class="field-group"><label asp-for="EducationLevel"></label><select asp-for="EducationLevel" asp-items="Html.GetEnumSelectList<EducationLevel>()" class="form-select" data-profile-field disabled><option value="">Not specified</option></select><span asp-validation-for="EducationLevel" class="text-danger"></span></div></div></section>
<div class="profile-form-actions" data-profile-actions><button type="button" class="btn btn-soft" data-profile-cancel>Cancel</button><button type="submit" form="profile-form" class="btn btn-primary" data-profile-save>Save changes →</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/student-details-validation.js" asp-append-version="true"></script><script src="~/js/autocomplete.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script><script src="~/js/profile.js" asp-append-version="true"></script> }
