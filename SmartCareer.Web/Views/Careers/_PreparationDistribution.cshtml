@model SmartCareer.Web.ViewModels.PreparationDistributionViewModel
<article class="preparation-card" aria-labelledby="preparation-@Model.ScaleId.ToLowerInvariant()">
    <h3 id="preparation-@Model.ScaleId.ToLowerInvariant()">@Model.Heading</h3>
    <p class="preparation-label">@Model.MostCommonLabel</p>
    <ul class="preparation-highlights">
        @foreach (var response in Model.MostCommonResponses) {
            <li><span>@response.CategoryDescription</span><strong>@response.Percentage.ToString("0.##")%</strong></li>
        }
    </ul>
    @if (Model.ScaleId == "RW") {
        <p class="preparation-help">This shows how much related work experience is commonly reported for this career. It is not a compulsory experience requirement for every job.</p>
    }
    else {
        @foreach (var response in Model.MostCommonResponses) {
            <p class="preparation-help">@response.Percentage.ToString("0.##")% of usable survey responses selected @response.CategoryDescription for this career.</p>
        }
    }
    @if (Model.AllResponses.Count > Model.MostCommonResponses.Count) {
        <details class="preparation-distribution"><summary>View all response categories</summary>
            <ul>@foreach (var response in Model.AllResponses) { <li><span>@response.CategoryDescription</span><strong>@response.Percentage.ToString("0.##")%</strong></li> }</ul>
        </details>
    }
</article>
