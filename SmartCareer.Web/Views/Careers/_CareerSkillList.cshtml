@model IReadOnlyList<SmartCareer.Web.ViewModels.CareerSkillViewModel>
@{ const int initiallyVisible = 6; var visibleSkills = Model.Take(initiallyVisible).ToList(); var remainingSkills = Model.Skip(initiallyVisible).ToList(); }
@if (Model.Count == 0) { <p class="skill-empty">No skill data is available in this group.</p> }
else {
    <div class="skill-card-grid">@foreach (var skill in visibleSkills) { <partial name="_CareerSkillCard" model="skill" /> }</div>
    @if (remainingSkills.Count > 0) {
        <details class="skill-expander"><summary><span class="show-all-label">Show All Skills (@Model.Count)</span><span class="show-less-label">Show Less</span></summary>
            <div class="skill-card-grid expanded-skill-grid">@foreach (var skill in remainingSkills) { <partial name="_CareerSkillCard" model="skill" /> }</div>
        </details>
    }
}
