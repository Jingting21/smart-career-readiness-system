@using Microsoft.AspNetCore.Identity
@using SmartCareer.Web.Models
@inject UserManager<ApplicationUser> UserManager
@{ ViewData["Title"] = "Dashboard"; var student = await UserManager.GetUserAsync(User); var name = student?.FullName?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there"; }
<div class="dashboard-wrap"><section class="welcome-banner"><div><span class="eyebrow">Your SmartCareer workspace</span><h1>Welcome back, @name!</h1><p>Your career journey is built one step at a time. Let’s explore what you can do next.</p></div><div class="welcome-symbol" aria-hidden="true">↗</div></section>
<div class="dashboard-heading"><div><h2>Your career journey</h2><p>Explore each area at your own pace. New tools will appear here as they become available.</p></div><span class="honest-status"><i></i> Foundation stage</span></div>
<div class="dashboard-grid">
    <article class="dashboard-card profile-card"><div class="card-top"><span class="feature-icon">○</span><span class="status-label available">Account ready</span></div><h3>My Profile</h3><p>Your core student details are safely connected to your account.</p><dl><div><dt>University</dt><dd>@(student?.University ?? "Not provided")</dd></div><div><dt>Course</dt><dd>@(student?.Course ?? "Not provided")</dd></div></dl><a asp-controller="Home" asp-action="ComingSoon" asp-route-feature="My Profile">View profile preview <span>→</span></a></article>
    <article class="dashboard-card"><div class="card-top"><span class="feature-icon">◇</span><span class="status-label">Coming soon</span></div><h3>Skills &amp; Interests</h3><p>A guided assessment will help you reflect on your strengths and preferences.</p><span class="card-state">Not started</span></article>
    <article class="dashboard-card"><div class="card-top"><span class="feature-icon">⌕</span><span class="status-label">Coming soon</span></div><h3>Career Explorer</h3><p>Future recommendations will help you explore suitable paths—without fabricated matches.</p><span class="card-state">Awaiting assessment</span></article>
    <article class="dashboard-card"><div class="card-top"><span class="feature-icon">✓</span><span class="status-label">Coming soon</span></div><h3>Career Readiness</h3><p>Understand your readiness and development areas when this module becomes available.</p><span class="card-state">No score available</span></article>
    <article class="dashboard-card"><div class="card-top"><span class="feature-icon">↗</span><span class="status-label">Coming soon</span></div><h3>My Roadmap</h3><p>Plan practical next steps toward your career goals in a personalised roadmap.</p><span class="card-state">Not created</span></article>
</div>
<section class="next-step"><div class="step-number">01</div><div><span class="eyebrow">What’s your next step?</span><h2>Start by checking the details in your profile.</h2><p>Profile management is still being prepared. For now, your registration details are shown above and no action is required.</p></div><a class="btn btn-primary" asp-controller="Home" asp-action="ComingSoon" asp-route-feature="My Profile">Learn what’s next</a></section></div>
