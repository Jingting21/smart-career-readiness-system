@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot Password"; }
<section class="auth-page"><div class="container"><div class="auth-card admin-login-card"><a class="back-link" asp-page="./Login">← Back to Login</a><div class="auth-heading"><span class="brand-mark">S</span><div><h1>Forgot Password</h1><p>Password recovery requires secure email delivery.</p></div></div>
@if (Model.Submitted) { <div class="alert alert-soft" role="status"><strong>No reset email was sent.</strong><br/>SmartCareer's email service is not configured yet. Please contact the project administrator for account recovery assistance.</div> }
else { <div class="info-callout"><strong>Email recovery is not available yet</strong><p>SmartCareer will support secure Identity reset tokens when an email delivery service is configured. This page does not expose whether an address is registered.</p></div><form method="post" class="mt-3" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field-group"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="email"/><span asp-validation-for="Input.Email" class="text-danger"></span></div><button type="submit" class="btn btn-primary w-100">Check recovery availability</button></form> }</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
