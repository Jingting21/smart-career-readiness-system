@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot Password"; }
<section class="auth-page"><div class="container"><div class="auth-card admin-login-card"><a class="back-link" asp-page="./Login">← Back to Login</a><div class="auth-heading"><span class="brand-mark">S</span><div><h1>Forgot Password</h1><p>Request a secure reset link for an eligible student account.</p></div></div>
@if (Model.Submitted) { <div class="alert alert-soft" role="status"><strong>Check your email</strong><br/>If an eligible student account exists and delivery succeeds, a password-reset link will arrive shortly.</div><p class="field-help mt-3">For security, SmartCareer gives the same response for every address.</p><a class="btn btn-soft w-100" asp-page="./Login">Return to Student Login</a> }
else { <form method="post" class="mt-3" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field-group"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Input.Email" class="text-danger"></span></div><button type="submit" class="btn btn-primary w-100">Send reset link</button></form> }</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
