@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.DeletePersonalDataModel
@{ ViewData["Title"] = "Delete Account"; }
<div class="settings-page settings-detail"><a class="back-link" asp-page="PersonalData">← Back to Personal Data</a><header class="detail-heading danger-heading"><span class="settings-icon">!</span><div><h1>Delete Account</h1><p>This permanently removes your SmartCareer account and stored student profile.</p></div></header><div class="danger-callout"><strong>This action cannot be undone.</strong><p>No account or data is deleted until you submit this confirmation form.</p></div><form method="post" class="settings-panel settings-form" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>@if(Model.RequirePassword){<div class="field-group"><label asp-for="Input.Password">Current password</label><div class="password-field"><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/><button type="button" class="password-toggle" data-toggle-password="Input_Password" data-password-label="current password" aria-label="Show current password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.Password" class="text-danger"></span></div>}<div class="form-check deletion-check"><input asp-for="Input.ConfirmDeletion" class="form-check-input"/><label asp-for="Input.ConfirmDeletion" class="form-check-label">I understand that deleting my account is permanent.</label><span asp-validation-for="Input.ConfirmDeletion" class="text-danger"></span></div><button type="submit" class="btn btn-danger">Permanently delete my account</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/password-toggle.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
