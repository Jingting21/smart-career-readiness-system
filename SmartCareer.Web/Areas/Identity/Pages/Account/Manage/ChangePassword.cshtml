@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{ ViewData["Title"] = "Password"; }
<div class="settings-page settings-detail"><a class="back-link" asp-page="Index">← Back to Settings</a><header class="detail-heading"><span class="settings-icon">◇</span><div><h1>Change Password</h1><p>Use a strong password you do not reuse elsewhere.</p></div></header>
@if (!string.IsNullOrEmpty(Model.StatusMessage)) { <div class="settings-alert success" role="status">@Model.StatusMessage</div> }
<form method="post" class="settings-panel settings-form" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="field-group"><label asp-for="Input.OldPassword"></label><div class="password-field"><input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" /><button type="button" class="password-toggle" data-toggle-password="Input_OldPassword" data-password-label="current password" aria-label="Show current password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.OldPassword" class="text-danger"></span></div>
<div class="field-group"><label asp-for="Input.NewPassword"></label><div class="password-field"><input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" data-toggle-password="Input_NewPassword" data-password-label="new password" aria-label="Show new password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.NewPassword" class="text-danger"></span></div>
<div class="field-group"><label asp-for="Input.ConfirmPassword"></label><div class="password-field"><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" data-toggle-password="Input_ConfirmPassword" data-password-label="password confirmation" aria-label="Show password confirmation" aria-pressed="false">Show</button></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Update password</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/password-toggle.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
