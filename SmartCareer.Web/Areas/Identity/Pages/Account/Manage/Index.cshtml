@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{ ViewData["Title"] = "Account Settings"; }
<div class="settings-page">
  <header class="settings-header"><div><span class="eyebrow">Your account</span><h1>Account Settings</h1><p>Manage your account, security and privacy.</p></div></header>
  <section class="account-summary" aria-label="Account summary"><span class="settings-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.CurrentUser.FullName) ? "S" : Model.CurrentUser.FullName[..1].ToUpperInvariant())</span><div><strong>@(Model.CurrentUser.FullName ?? "Student")</strong><span>@Model.CurrentUser.Email</span></div><span class="account-role">@(Model.Roles.FirstOrDefault() ?? "Student") account</span></section>
  <section class="settings-section" aria-labelledby="account-security"><div class="settings-section-heading"><h2 id="account-security">Account &amp; Security</h2><p>Sign-in details and safeguards for your account.</p></div><div class="settings-grid">
    <a class="settings-card" asp-page="Email"><span class="settings-icon" aria-hidden="true">@@</span><span><strong>Email Address</strong><small>View the Google email registered with SmartCareer.</small></span><span class="settings-state">Read only</span><span class="card-arrow" aria-hidden="true">→</span></a>
    <a class="settings-card" asp-page="@(Model.HasPassword ? "ChangePassword" : "SetPassword")"><span class="settings-icon" aria-hidden="true">◇</span><span><strong>Password</strong><small>@(Model.HasPassword ? "Change your SmartCareer password securely." : "Add a SmartCareer password as another sign-in method.")</small></span><span class="settings-state">@(Model.HasPassword ? "Available" : "Not set")</span><span class="card-arrow" aria-hidden="true">→</span></a>
    <a class="settings-card" asp-page="ExternalLogins"><span class="settings-icon" aria-hidden="true">G</span><span><strong>Connected Google Account</strong><small>Review the Google account used to sign in.</small></span><span class="settings-state @(Model.GoogleConnected ? "is-on" : "")">@(Model.GoogleConnected ? "Connected" : "Not connected")</span><span class="card-arrow" aria-hidden="true">→</span></a>
  </div></section>
  <section class="settings-section" aria-labelledby="privacy-data"><div class="settings-section-heading"><h2 id="privacy-data">Privacy &amp; Data</h2><p>Download your account information or manage account removal.</p></div><div class="settings-grid single"><a class="settings-card" asp-page="PersonalData"><span class="settings-icon" aria-hidden="true">▤</span><span><strong>Personal Data</strong><small>Download your data or request permanent account deletion.</small></span><span class="card-arrow" aria-hidden="true">→</span></a></div></section>
</div>
