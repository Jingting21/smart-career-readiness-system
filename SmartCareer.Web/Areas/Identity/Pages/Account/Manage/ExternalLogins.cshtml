@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.ExternalLoginsModel
@{ ViewData["Title"] = "Connected Accounts"; }
<div class="settings-page settings-detail"><a class="back-link" asp-page="Index">← Back to Settings</a><header class="detail-heading"><span class="settings-icon">G</span><div><h1>Connected Google Account</h1><p>Google is the sign-in provider for SmartCareer students.</p></div></header>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="settings-alert" role="status">@Model.StatusMessage</div> }
<section class="settings-panel"><h2>Google connection</h2>
@if (Model.GoogleConnected) { <div class="provider-row"><span class="provider-mark">G</span><div><strong>Google</strong><small>Connected · @Model.Email</small></div>@if(Model.CanRemoveGoogle){<form method="post" asp-page-handler="RemoveLogin"><input type="hidden" name="loginProvider" value="Google"/><input type="hidden" name="providerKey" value="@Model.CurrentLogins.First(l => l.LoginProvider == "Google").ProviderKey"/><button class="btn btn-outline-danger btn-sm" type="submit">Disconnect</button></form>}else{<span class="settings-state is-on">Only sign-in method</span>}</div><div class="info-callout"><strong>Secure sign-in methods</strong><p>Google can only be disconnected when a local password or another usable login method exists. SmartCareer cannot determine whether Google 2-Step Verification is enabled.</p></div> }
else if (Model.OtherLogins.Any()) { <div class="provider-row"><span class="provider-mark">G</span><div><strong>Google</strong><small>Not connected</small></div><form method="post" asp-page-handler="LinkLogin"><input type="hidden" name="provider" value="Google"/><button class="btn btn-primary btn-sm" type="submit">Connect Google</button></form></div><div class="info-callout"><strong>Legacy account migration</strong><p>Connect Google only after verifying this existing SmartCareer account. Identity correlation checks ensure the selected Google identity is linked to the currently signed-in student.</p></div> }
else { <div class="info-callout"><strong>Google sign-in is unavailable</strong><p>The application administrator must configure Google OAuth before this account can be migrated.</p></div> }
</section></div>
