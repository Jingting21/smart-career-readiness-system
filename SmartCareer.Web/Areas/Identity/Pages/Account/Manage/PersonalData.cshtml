@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.PersonalDataModel
@{ ViewData["Title"] = "Personal Data"; }
<div class="settings-page settings-detail"><a class="back-link" asp-page="Index">← Back to Settings</a><header class="detail-heading"><span class="settings-icon">▤</span><div><h1>Personal Data &amp; Privacy</h1><p>Access the information stored with your SmartCareer account.</p></div></header><div class="settings-stack"><section class="settings-panel action-panel"><div><h2>Download your data</h2><p>The download includes Identity account fields and your SmartCareer student profile fields: name, university, course and education level.</p></div><form method="post" asp-page="DownloadPersonalData"><button class="btn btn-soft" type="submit">Download data</button></form></section><section class="settings-panel action-panel danger-panel"><div><h2>Delete account</h2><p>Permanently deletes your Identity account and the student profile fields stored on it. This cannot be undone and always requires a separate confirmation step@(Model.RequirePassword ? " plus your current password" : "").</p></div><a class="btn btn-outline-danger" asp-page="DeletePersonalData">Review account deletion</a></section></div></div>
