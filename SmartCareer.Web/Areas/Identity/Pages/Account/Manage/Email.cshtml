@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.Manage.EmailModel
@{ ViewData["Title"] = "Email Address"; }
<div class="settings-page settings-detail"><a class="back-link" asp-page="Index">← Back to Settings</a><header class="detail-heading"><span class="settings-icon" aria-hidden="true">@@</span><div><h1>Email Address</h1><p>Review the email registered with SmartCareer.</p></div></header>
<section class="settings-panel"><div class="detail-row"><div><span class="detail-label">Current email</span><strong>@Model.Email</strong></div><span class="settings-state @(Model.IsConfirmed ? "is-on" : "")">@(Model.IsConfirmed ? "Confirmed" : "Unconfirmed")</span></div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-soft mt-3" role="status">@Model.StatusMessage</div> }
@if (!Model.IsConfirmed) { <div class="info-callout"><strong>Verify your email</strong><p>Verify this address before using future features that store sensitive career assessment data.</p><form method="post" asp-page="ResendEmailConfirmation"><button type="submit" class="btn btn-primary">Resend Verification Email</button></form></div> }
<div class="info-callout"><strong>Email changes are currently unavailable</strong><p>Your registered address cannot be replaced from Account Settings yet. SmartCareer will continue using this address for account and future notification features.</p></div></section></div>
