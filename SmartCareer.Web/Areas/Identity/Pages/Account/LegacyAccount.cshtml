@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.LegacyAccountModel
@{ ViewData["Title"] = "Connect an existing account"; }
<section class="auth-page"><div class="container"><div class="auth-card legacy-card"><a class="back-link" asp-page="./Login">← Back to Google sign in</a><div class="auth-heading"><span class="brand-mark">S</span><div><h1>Connect an existing account</h1><p>Only use this page if you previously created a SmartCareer password account.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-soft" role="status">@Model.ErrorMessage</div> }
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field-group"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username"/><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="field-group"><label asp-for="Input.Password"></label><div class="password-field"><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/><button type="button" class="password-toggle" data-toggle-password="Input_Password" data-password-label="password" aria-label="Show password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.Password" class="text-danger"></span></div><button type="submit" class="btn btn-primary w-100">Verify existing account</button></form><p class="field-help mt-3">After verification, connect Google from Connected Accounts. Your existing password is not removed.</p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/password-toggle.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
