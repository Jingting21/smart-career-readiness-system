@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-2">Welcome back</h1>
                <p class="text-muted mb-4">Sign in to continue to Smart Career.</p>

                @if (Model.ExternalLogins.Any(scheme => scheme.Name == "Google"))
                {
                    <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="mb-4">
                        <button type="submit" name="provider" value="Google" class="btn btn-outline-dark w-100">Continue with Google</button>
                    </form>
                    <div class="auth-divider"><span>or sign in with email</span></div>
                }
                else
                {
                    <div class="alert alert-light border small" role="status">Google login is unavailable until OAuth credentials are configured.</div>
                }

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                                <label asp-for="Input.Password"></label>
                            </div>
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="Input_Password">Show</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>
                <p class="text-center mt-4 mb-0">New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
