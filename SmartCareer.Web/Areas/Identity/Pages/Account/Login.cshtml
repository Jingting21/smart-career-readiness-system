@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.LoginModel
@{ ViewData["Title"] = "Welcome Back"; }
<section class="auth-page"><div class="container auth-layout"><div class="auth-support"><span class="eyebrow">Continue your journey</span><h1>Small steps today shape where you go next.</h1><p>Return to your workspace and keep building clarity, confidence, and career direction.</p><div class="auth-quote"><span>“</span><p>Your path does not need to be perfectly clear before you take the next step.</p></div></div>
<div class="auth-card"><div class="auth-heading"><span class="brand-mark">S</span><div><h2>Welcome Back</h2><p>Sign in to continue your SmartCareer journey.</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="validation-summary validation-summary-errors" role="alert">@Model.ErrorMessage</div> }
@if (Model.ExternalLogins.Any(scheme => scheme.Name == "Google")) { <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl"><button type="submit" name="provider" value="Google" class="btn btn-google w-100"><span class="google-g">G</span>Continue with Google</button></form><div class="auth-divider"><span>or sign in with email</span></div> } else { <div class="alert alert-soft" role="status">Google sign-in is unavailable until OAuth credentials are configured.</div> }
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-validation-focus><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field-group"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com"/><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="field-group"><label asp-for="Input.Password"></label><div class="password-field"><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/><button type="button" class="password-toggle" data-toggle-password="Input_Password" data-password-label="password" aria-label="Show password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="form-check auth-check"><input asp-for="Input.RememberMe" class="form-check-input"/><label asp-for="Input.RememberMe" class="form-check-label"></label></div><div class="auth-form-links"><a asp-page="./ForgotPassword">Forgot password?</a></div><button type="submit" class="btn btn-primary btn-lg w-100">Login <span aria-hidden="true">→</span></button></form><p class="auth-switch">New to SmartCareer? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/password-toggle.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script> }
