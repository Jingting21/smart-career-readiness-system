@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.RegisterModel
@using SmartCareer.Web.Models
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-page register-page"><div class="container auth-layout"><div class="auth-support"><span class="eyebrow">Begin with who you are</span><h1>Your career journey starts with a simple introduction.</h1><p>Choose recognised study details from the suggestions, or select Other to enter them manually.</p></div>
<div class="auth-card register-card"><div class="auth-heading"><span class="brand-mark">S</span><div><h2>Let’s get to know you.</h2><p>Create your account and start exploring your career possibilities.</p></div></div>
@if (Model.ExternalLogins.Any(s => s.Name == "Google")) { <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl"><button type="submit" name="provider" value="Google" class="btn btn-google w-100"><span class="google-g">G</span>Continue with Google</button></form><div class="auth-divider"><span>or register with email</span></div> }
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-validation-focus data-server-validation-errors="@Model.ShowPasswordReentryNotice.ToString().ToLowerInvariant()"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid">
<div class="field-group full"><label asp-for="Input.FullName"></label><input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Your full name" /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
<div class="field-group selection-field" data-controlled-selection><label asp-for="Input.University"></label><input asp-for="Input.UniversitySelectionMode" type="hidden" data-selection-mode /><input asp-for="Input.UniversityConfirmed" type="hidden" data-selection-confirmed /><div data-catalog-field><input asp-for="Input.University" class="form-control" autocomplete="off" placeholder="Search universities" data-autocomplete-url="/api/registration-options/universities" data-val-catalogselection="Please select a university from the suggestions or choose Other — Enter manually." aria-autocomplete="list" aria-controls="university-suggestions" aria-describedby="Input_University-error" aria-expanded="false" role="combobox" /><div id="university-suggestions" class="autocomplete-list" role="listbox"></div><span asp-validation-for="Input.University" id="Input_University-error" class="text-danger"></span></div><div data-custom-field><input asp-for="Input.CustomUniversity" class="form-control" placeholder="Enter university name" data-rule-manualentry="university" /><small class="field-help">This value will be saved as manually entered and unverified.</small><span asp-validation-for="Input.CustomUniversity" class="text-danger"></span></div><button type="button" class="selection-switch" data-selection-switch></button></div>
<div class="field-group selection-field" data-controlled-selection><label asp-for="Input.Course"></label><input asp-for="Input.CourseSelectionMode" type="hidden" data-selection-mode /><input asp-for="Input.CourseConfirmed" type="hidden" data-selection-confirmed /><div data-catalog-field><input asp-for="Input.Course" class="form-control" autocomplete="off" placeholder="Search courses" data-autocomplete-url="/api/registration-options/courses" data-val-catalogselection="Please select a course from the suggestions or choose Other — Enter manually." aria-autocomplete="list" aria-controls="course-suggestions" aria-describedby="Input_Course-error" aria-expanded="false" role="combobox" /><div id="course-suggestions" class="autocomplete-list" role="listbox"></div><span asp-validation-for="Input.Course" id="Input_Course-error" class="text-danger"></span></div><div data-custom-field><input asp-for="Input.CustomCourse" class="form-control" placeholder="Enter course name" data-rule-manualentry="course" /><small class="field-help">This value will be saved as manually entered and unverified.</small><span asp-validation-for="Input.CustomCourse" class="text-danger"></span></div><button type="button" class="selection-switch" data-selection-switch></button></div>
<div class="field-group"><label asp-for="Input.EducationLevel"></label><select asp-for="Input.EducationLevel" asp-items="Html.GetEnumSelectList<EducationLevel>()" class="form-select"><option value="">Choose a level</option></select><span asp-validation-for="Input.EducationLevel" class="text-danger"></span></div>
<div class="field-group"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="field-group"><label asp-for="Input.Password"></label>@if (Model.ShowPasswordReentryNotice) { <div class="password-reentry-notice" role="status" data-password-reentry-notice>Please re-enter your password to complete registration.</div> }<div class="password-field"><input asp-for="Input.Password" class="form-control" autocomplete="new-password" data-password-primary /><button class="password-toggle" type="button" data-toggle-password="Input_Password" data-password-label="password" aria-label="Show password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.Password" class="text-danger"></span><div class="strength-track"><span data-strength-bar></span></div><small data-password-strength>Strength: not entered</small></div>
<div class="field-group"><label asp-for="Input.ConfirmPassword"></label><div class="password-field"><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" data-password-confirm /><button class="password-toggle" type="button" data-toggle-password="Input_ConfirmPassword" data-password-label="password confirmation" aria-label="Show password confirmation" aria-pressed="false">Show</button></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span><small data-password-match></small></div></div>
<ul class="password-requirements"><li data-password-rule="length">8+ characters</li><li data-password-rule="upper">Uppercase</li><li data-password-rule="lower">Lowercase</li><li data-password-rule="digit">Number</li><li data-password-rule="symbol">Symbol</li></ul><button type="submit" class="btn btn-primary btn-lg w-100">Create account →</button></form><p class="auth-switch">Already registered? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/student-details-validation.js" asp-append-version="true"></script><script src="~/js/autocomplete.js" asp-append-version="true"></script><script src="~/js/form-validation-focus.js" asp-append-version="true"></script><script src="~/js/password-toggle.js" asp-append-version="true"></script><script src="~/js/registration.js" asp-append-version="true"></script> }
