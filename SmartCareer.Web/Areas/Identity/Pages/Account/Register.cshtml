@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-page register-page"><div class="container auth-layout"><div class="auth-support"><span class="eyebrow">Begin with who you are</span><h1>Your career journey starts with a simple introduction.</h1><p>Tell us a little about your studies. You can type your own university or course if it does not appear in the suggestions.</p><ol class="auth-steps"><li class="active"><span>1</span><div><strong>Create your account</strong><small>Your basic student details</small></div></li><li><span>2</span><div><strong>Discover your strengths</strong><small>Assessment coming soon</small></div></li><li><span>3</span><div><strong>Explore your direction</strong><small>Career tools coming soon</small></div></li></ol></div>
<div class="auth-card register-card"><div class="auth-heading"><span class="brand-mark">S</span><div><h2>Let’s get to know you.</h2><p>Create your account and start exploring your career possibilities.</p></div></div>
@if (Model.ExternalLogins.Any(scheme => scheme.Name == "Google")) { <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl"><button type="submit" name="provider" value="Google" class="btn btn-google w-100"><span class="google-g">G</span>Continue with Google</button></form><div class="auth-divider"><span>or register with email</span></div> } else { <div class="alert alert-soft" role="status">Google registration is unavailable until OAuth credentials are configured.</div> }
<form method="post" asp-route-returnUrl="@Model.ReturnUrl"><div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
<div class="form-grid"><div class="field-group full"><label asp-for="Input.FullName"></label><input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Your full name" /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
<div class="field-group autocomplete-wrap"><label asp-for="Input.University"></label><input asp-for="Input.University" class="form-control" autocomplete="off" placeholder="Start typing or enter manually" data-autocomplete-url="/api/registration-options/universities" aria-autocomplete="list" aria-controls="university-suggestions" aria-expanded="false" role="combobox" /><div id="university-suggestions" class="autocomplete-list" role="listbox"></div><span asp-validation-for="Input.University" class="text-danger"></span></div>
<div class="field-group autocomplete-wrap"><label asp-for="Input.Course"></label><input asp-for="Input.Course" class="form-control" autocomplete="off" placeholder="Start typing or enter manually" data-autocomplete-url="/api/registration-options/courses" aria-autocomplete="list" aria-controls="course-suggestions" aria-expanded="false" role="combobox" /><div id="course-suggestions" class="autocomplete-list" role="listbox"></div><span asp-validation-for="Input.Course" class="text-danger"></span></div>
<div class="field-group full"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="field-group"><label asp-for="Input.Password"></label><div class="password-field"><input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Create a strong password" data-password-primary /><button class="password-toggle" type="button" data-toggle-password="Input_Password" aria-pressed="false">Show</button></div><span asp-validation-for="Input.Password" class="text-danger"></span><div class="strength-track"><span data-strength-bar></span></div><div class="small strength-label" data-password-strength aria-live="polite">Strength: not entered</div></div>
<div class="field-group"><label asp-for="Input.ConfirmPassword"></label><div class="password-field"><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat your password" data-password-confirm /><button class="password-toggle" type="button" data-toggle-password="Input_ConfirmPassword" aria-pressed="false">Show</button></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span><div class="small match-label" data-password-match aria-live="polite"></div></div></div>
<ul class="password-requirements" aria-label="Password requirements" aria-live="polite"><li data-password-rule="length">8+ characters</li><li data-password-rule="upper">Uppercase</li><li data-password-rule="lower">Lowercase</li><li data-password-rule="digit">Number</li><li data-password-rule="symbol">Symbol</li></ul>
<button type="submit" class="btn btn-primary btn-lg w-100">Create account <span aria-hidden="true">→</span></button></form><p class="auth-switch">Already registered? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/registration.js" asp-append-version="true"></script> }
