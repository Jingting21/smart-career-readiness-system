@page
@model SmartCareer.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-2">Create your student account</h1>
                <p class="text-muted mb-4">Enter your university information to get started.</p>

                @if (Model.ExternalLogins.Any(scheme => scheme.Name == "Google"))
                {
                    <form method="post" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="mb-4">
                        <button type="submit" name="provider" value="Google" class="btn btn-outline-dark w-100">
                            Continue with Google
                        </button>
                    </form>
                    <div class="auth-divider"><span>or register with email</span></div>
                }
                else
                {
                    <div class="alert alert-light border small" role="status">
                        Google registration is unavailable until OAuth credentials are configured.
                    </div>
                }

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Full name" />
                        <label asp-for="Input.FullName"></label>
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.University" class="form-control" autocomplete="off" placeholder="University"
                               data-autocomplete-url="/api/registration-options/universities" aria-autocomplete="list"
                               aria-controls="university-suggestions" aria-expanded="false" role="combobox" />
                        <label asp-for="Input.University"></label>
                        <div id="university-suggestions" class="autocomplete-list" role="listbox"></div>
                        <span asp-validation-for="Input.University" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Course" class="form-control" autocomplete="off" placeholder="Course"
                               data-autocomplete-url="/api/registration-options/courses" aria-autocomplete="list"
                               aria-controls="course-suggestions" aria-expanded="false" role="combobox" />
                        <label asp-for="Input.Course"></label>
                        <div id="course-suggestions" class="autocomplete-list" role="listbox"></div>
                        <span asp-validation-for="Input.Course" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" data-password-primary />
                                <label asp-for="Input.Password"></label>
                            </div>
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="Input_Password">Show</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <ul class="password-requirements mt-2 mb-1" aria-live="polite">
                            <li data-password-rule="length">At least 8 characters</li>
                            <li data-password-rule="upper">One uppercase letter</li>
                            <li data-password-rule="lower">One lowercase letter</li>
                            <li data-password-rule="digit">One number</li>
                            <li data-password-rule="symbol">One symbol</li>
                        </ul>
                        <div class="small" data-password-strength aria-live="polite">Strength: not entered</div>
                    </div>
                    <div class="mb-4">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm password" data-password-confirm />
                                <label asp-for="Input.ConfirmPassword"></label>
                            </div>
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="Input_ConfirmPassword">Show</button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        <div class="small mt-1" data-password-match aria-live="polite"></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>

                <p class="text-center mt-4 mb-0">
                    Already registered?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js" asp-append-version="true"></script>
}
